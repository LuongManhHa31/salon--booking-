DATABASE_URL="postgresql://postgres:postgres@localhost:5432/salon_booking?schema=public"
JWT_SECRET="change-this-to-a-long-random-string"
PORT=4000
CORS_ORIGIN="http://localhost:5173"

# Gợi ý kiểu tóc bằng AI (UC016) luôn dùng Claude vision - bắt buộc cần key này.
ANTHROPIC_API_KEY=""

# Chatbot tư vấn (UC019) và gợi ý kiểu tóc AI (UC016): nếu điền GEMINI_API_KEY thì ưu tiên dùng
# Gemini; nếu để trống thì tự động dùng ANTHROPIC_API_KEY (Claude) ở trên. Lấy key tại
# https://aistudio.google.com/apikey. Key này cũng dùng để tạo embedding cho RAG (backend/src/rag)
# - nếu để trống, RAG tự động chuyển sang tìm kiếm theo từ khóa thay vì tìm kiếm ngữ nghĩa.
#
# Có thể điền NHIỀU key cách nhau bằng dấu phẩy (mỗi key lấy từ một tài khoản Google khác nhau,
# mỗi tài khoản có quota free-tier 20 request/ngày riêng). Khi key đang dùng bị lỗi hết quota
# (429), hệ thống tự động chuyển sang key tiếp theo trong danh sách (xem backend/src/utils/gemini.ts).
# Ví dụ: GEMINI_API_KEY="key-tai-khoan-1,key-tai-khoan-2,key-tai-khoan-3"
GEMINI_API_KEY=""

# Tuỳ chọn: cấu hình SMTP để gửi email nhắc lịch thật (UC009). Nếu để trống, hệ thống chỉ tạo
# thông báo trong ứng dụng và ghi log ra console thay vì gửi email.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Salon AI Booking <no-reply@salon.local>"
